        "x-codeSamples": [
          {
            "lang": "cURL",
            "source": "curl https://api.smartsheet.com/2.0/webhooks/{webhookId} \\\n-H \"Authorization: Bearer JKlMNOpQ12RStUVwxYZAbcde3F5g6hijklM789\" \\\n-H \"Content-Type: application/json\" \\\n-X PUT \\\n-d '{ \"enabled\": true }'"
