      "post": {
        "summary": "Copy Rows to Another Sheet",
        "description": "Copies rows from the sheet specified in the URL to (the bottom of) another sheet.",
        "operationId": "copy-rows",
        "tags": [
          "rows"
        ],
        "security": [
          {
            "APIToken": []
          },
          {
            "OAuth2": [
              "WRITE_SHEETS"
